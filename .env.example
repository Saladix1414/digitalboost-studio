VITE_OLLAMA_MODE=local
VITE_OLLAMA_LOCAL_URL=http://localhost:11434
VITE_OLLAMA_PROD_URL=/api/ollama
VITE_OLLAMA_MODEL=qwen2:1.5b

# Server runtime: injected by the host (this file is not automatically loaded).
PORT=3000
# npm start already sets NODE_ENV=production.
# GEMINI_API_KEY=configure-only-as-a-server-secret

# Disabled until real services and credentials are configured.
DIGITALBOOST_INFRA_DATABASE_PROVIDER=disabled
DIGITALBOOST_INFRA_CACHE_PROVIDER=disabled
DIGITALBOOST_INFRA_OBJECT_STORAGE_PROVIDER=disabled
DIGITALBOOST_INFRA_QUEUE_PROVIDER=disabled
# REDIS_URL=redis://HOST:6379
# QUEUE_REDIS_URL=redis://HOST:6379
# OBJECT_STORAGE_ENDPOINT=https://YOUR-S3-ENDPOINT
# OBJECT_STORAGE_BUCKET=YOUR-BUCKET

# Optional Commerce OS persistence (requires a reachable PostgreSQL instance)
# DIGITALBOOST_INFRA_DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
