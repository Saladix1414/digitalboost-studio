import {
  Box,
  ChevronDown,
  ChevronRight,
  Eye,
  FileText,
  Layers3,
  Monitor,
  MousePointer2,
  PanelRight,
  Plus,
  Save,
  Smartphone,
  Tablet,
  ShoppingBag,
  Sparkles,
  Store,
  Type,
  Undo2,
  Redo2,
} from "lucide-react";
import { useState } from "react";

type BuilderMode = "web" | "store";
type Viewport = "desktop" | "tablet" | "mobile";

type BuilderElement = {
  id: string;
  type: string;
  label: string;
  icon: React.ElementType;
};

const elements: BuilderElement[] = [
  {
    id: "hero",
    type: "hero",
    label: "Hero",
    icon: Layers3,
  },
  {
    id: "text",
    type: "text",
    label: "Texto",
    icon: Type,
  },
  {
    id: "products",
    type: "products",
    label: "Productos",
    icon: ShoppingBag,
  },
  {
    id: "section",
    type: "section",
    label: "Sección",
    icon: Box,
  },
];

const initialCanvas = [
  { id: "header", label: "Header", type: "header" },
  { id: "hero", label: "Hero principal", type: "hero" },
  { id: "products", label: "Productos destacados", type: "products" },
  { id: "footer", label: "Footer", type: "footer" },
];

export default function VisualBuilderShell() {
  const [mode, setMode] = useState<BuilderMode>("store");
  const [viewport, setViewport] = useState<Viewport>("desktop");
  const [selected, setSelected] = useState("hero");
  const [canvas, setCanvas] = useState(initialCanvas);

  const addElement = (element: BuilderElement) => {
    const id = `${element.type}-${Date.now()}`;

    setCanvas((current) => [
      ...current,
      {
        id,
        label: element.label,
        type: element.type,
      },
    ]);

    setSelected(id);
  };

  const viewportClass =
    viewport === "desktop"
      ? "w-full"
      : viewport === "tablet"
        ? "w-[768px] max-w-full"
        : "w-[390px] max-w-full";

  return (
    <div className="flex h-full min-h-[720px] min-w-0 flex-col overflow-hidden rounded-2xl border border-white/[.08] bg-[#050912] text-white shadow-2xl">

      {/* TOP BAR */}
      <header className="flex h-14 shrink-0 items-center justify-between border-b border-white/[.07] bg-[#070c16] px-3">

        <div className="flex items-center gap-3">
          <div className="flex h-8 w-8 items-center justify-center rounded-lg border border-cyan-400/20 bg-cyan-400/10 text-cyan-300">
            <Sparkles size={16} />
          </div>

          <div>
            <div className="text-xs font-semibold">
              Visual Builder
            </div>
            <div className="text-[10px] text-slate-500">
              {mode === "store" ? "Tienda online" : "Sitio web"}
            </div>
          </div>

          <div className="ml-2 flex rounded-lg border border-white/[.07] bg-black/20 p-0.5">
            <button
              type="button"
              onClick={() => setMode("web")}
              className={`flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[11px] transition ${
                mode === "web"
                  ? "bg-white/10 text-white"
                  : "text-slate-500 hover:text-white"
              }`}
            >
              <FileText size={13} />
              Web
            </button>

            <button
              type="button"
              onClick={() => setMode("store")}
              className={`flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[11px] transition ${
                mode === "store"
                  ? "bg-cyan-400/10 text-cyan-300"
                  : "text-slate-500 hover:text-white"
              }`}
            >
              <Store size={13} />
              Tienda
            </button>
          </div>
        </div>

        <div className="hidden items-center gap-1 rounded-lg border border-white/[.07] bg-black/20 p-1 md:flex">
          <button
            type="button"
            onClick={() => setViewport("desktop")}
            className={`rounded-md p-2 ${
              viewport === "desktop"
                ? "bg-white/10 text-white"
                : "text-slate-500"
            }`}
            title="Desktop"
          >
            <Monitor size={15} />
          </button>

          <button
            type="button"
            onClick={() => setViewport("tablet")}
            className={`rounded-md p-2 ${
              viewport === "tablet"
                ? "bg-white/10 text-white"
                : "text-slate-500"
            }`}
            title="Tablet"
          >
            <Tablet size={15} />
          </button>

          <button
            type="button"
            onClick={() => setViewport("mobile")}
            className={`rounded-md p-2 ${
              viewport === "mobile"
                ? "bg-white/10 text-white"
                : "text-slate-500"
            }`}
            title="Mobile"
          >
            <Smartphone size={15} />
          </button>
        </div>

        <div className="flex items-center gap-1">
          <button
            type="button"
            className="hidden rounded-lg p-2 text-slate-500 transition hover:bg-white/5 hover:text-white sm:block"
            title="Deshacer"
          >
            <Undo2 size={15} />
          </button>

          <button
            type="button"
            className="hidden rounded-lg p-2 text-slate-500 transition hover:bg-white/5 hover:text-white sm:block"
            title="Rehacer"
          >
            <Redo2 size={15} />
          </button>

          <button
            type="button"
            className="flex items-center gap-1.5 rounded-lg border border-white/[.08] bg-white/[.03] px-3 py-2 text-[11px] text-slate-300 hover:bg-white/[.06]"
          >
            <Eye size={14} />
            Preview
          </button>

          <button
            type="button"
            className="flex items-center gap-1.5 rounded-lg bg-cyan-400 px-3 py-2 text-[11px] font-semibold text-slate-950 transition hover:bg-cyan-300"
          >
            <Save size={14} />
            Guardar
          </button>
        </div>
      </header>

      {/* WORKSPACE */}
      <div className="flex min-h-0 flex-1">

        {/* LEFT PANEL */}
        <aside className="hidden w-60 shrink-0 border-r border-white/[.07] bg-[#070c16] lg:flex lg:flex-col">

          <div className="border-b border-white/[.07] p-4">
            <div className="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-500">
              Añadir
            </div>

            <div className="mt-3 grid grid-cols-2 gap-2">
              {elements.map((element) => {
                const Icon = element.icon;

                return (
                  <button
                    key={element.id}
                    type="button"
                    onClick={() => addElement(element)}
                    className="group rounded-xl border border-white/[.07] bg-white/[.02] p-3 text-left transition hover:border-cyan-400/20 hover:bg-cyan-400/[.04]"
                  >
                    <Icon
                      size={16}
                      className="text-slate-400 transition group-hover:text-cyan-300"
                    />

                    <div className="mt-2 text-[11px] font-medium">
                      {element.label}
                    </div>

                    <div className="mt-1 text-[9px] text-slate-600">
                      Agregar
                    </div>
                  </button>
                );
              })}
            </div>
          </div>

          <div className="min-h-0 flex-1 overflow-auto p-4">
            <div className="flex items-center justify-between">
              <div className="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-500">
                Páginas
              </div>

              <button
                type="button"
                className="rounded-md p-1 text-slate-500 hover:bg-white/5 hover:text-white"
              >
                <Plus size={14} />
              </button>
            </div>

            <div className="mt-3 space-y-1">
              {["Inicio", "Productos", "Colecciones", "Nosotros"].map(
                (page, index) => (
                  <button
                    key={page}
                    type="button"
                    className={`flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-[11px] ${
                      index === 0
                        ? "bg-cyan-400/[.07] text-cyan-300"
                        : "text-slate-400 hover:bg-white/[.03] hover:text-white"
                    }`}
                  >
                    <FileText size={13} />
                    {page}
                  </button>
                )
              )}
            </div>
          </div>
        </aside>

        {/* CANVAS */}
        <main className="relative min-w-0 flex-1 overflow-auto bg-[#02050b]">

          <div className="pointer-events-none absolute inset-0 opacity-40"
            style={{
              backgroundImage:
                "linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px)",
              backgroundSize: "24px 24px",
            }}
          />

          <div className="relative flex min-h-full justify-center p-6 md:p-10">

            <div
              className={`${viewportClass} min-h-[620px] overflow-hidden rounded-xl border border-white/[.08] bg-white shadow-[0_30px_100px_rgba(0,0,0,.45)] transition-all`}
            >

              {/* SIMULATED SITE */}
              <div className="min-h-full bg-slate-50 text-slate-900">

                <div
                  onClick={() => setSelected("header")}
                  className={`cursor-pointer border-b bg-white px-6 py-4 transition ${
                    selected === "header"
                      ? "ring-2 ring-inset ring-cyan-400"
                      : ""
                  }`}
                >
                  <div className="flex items-center justify-between">
                    <div className="font-bold tracking-tight">
                      TU MARCA
                    </div>

                    <div className="hidden gap-5 text-xs text-slate-500 sm:flex">
                      <span>Inicio</span>
                      <span>Productos</span>
                      <span>Nosotros</span>
                      <span>Contacto</span>
                    </div>

                    <ShoppingBag size={17} />
                  </div>
                </div>

                <div
                  onClick={() => setSelected("hero")}
                  className={`cursor-pointer px-8 py-16 transition sm:px-12 sm:py-24 ${
                    selected === "hero"
                      ? "ring-2 ring-inset ring-cyan-400"
                      : ""
                  }`}
                >
                  <div className="mx-auto max-w-3xl text-center">
                    <div className="mx-auto mb-4 inline-flex rounded-full bg-slate-900 px-3 py-1 text-[9px] font-semibold uppercase tracking-[.2em] text-white">
                      Nueva colección
                    </div>

                    <h1 className="text-3xl font-bold tracking-tight sm:text-5xl">
                      Una tienda diseñada para vender.
                    </h1>

                    <p className="mx-auto mt-4 max-w-xl text-sm leading-6 text-slate-500">
                      Creá una experiencia digital moderna y conectala
                      directamente con tu CommerceOS.
                    </p>

                    <button className="mt-7 rounded-lg bg-slate-950 px-5 py-3 text-xs font-semibold text-white">
                      Comprar ahora
                    </button>
                  </div>
                </div>

                <div
                  onClick={() => setSelected("products")}
                  className={`cursor-pointer px-8 py-12 transition sm:px-12 ${
                    selected === "products"
                      ? "ring-2 ring-inset ring-cyan-400"
                      : ""
                  }`}
                >
                  <div className="mb-6 flex items-end justify-between">
                    <div>
                      <div className="text-[9px] font-semibold uppercase tracking-[.18em] text-slate-400">
                        Selección
                      </div>

                      <h2 className="mt-1 text-xl font-bold">
                        Productos destacados
                      </h2>
                    </div>

                    <span className="text-[10px] text-slate-400">
                      Ver todos →
                    </span>
                  </div>

                  <div className="grid grid-cols-2 gap-3 sm:grid-cols-3">
                    {[1, 2, 3].map((item) => (
                      <div
                        key={item}
                        className="overflow-hidden rounded-xl border border-slate-200 bg-white"
                      >
                        <div className="aspect-square bg-slate-100" />
                        <div className="p-3">
                          <div className="text-xs font-semibold">
                            Producto {item}
                          </div>
                          <div className="mt-1 text-[10px] text-slate-400">
                            $24.990
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                <div
                  onClick={() => setSelected("footer")}
                  className={`border-t px-8 py-10 transition ${
                    selected === "footer"
                      ? "ring-2 ring-inset ring-cyan-400"
                      : ""
                  }`}
                >
                  <div className="text-xs font-semibold">
                    TU MARCA
                  </div>
                  <div className="mt-2 text-[10px] text-slate-400">
                    © 2026 · Powered by DigitalBoost
                  </div>
                </div>
              </div>
            </div>
          </div>
        </main>

        {/* RIGHT INSPECTOR */}
        <aside className="hidden w-72 shrink-0 border-l border-white/[.07] bg-[#070c16] xl:flex xl:flex-col">

          <div className="flex h-12 items-center justify-between border-b border-white/[.07] px-4">
            <div className="flex items-center gap-2">
              <PanelRight size={14} className="text-cyan-300" />
              <span className="text-xs font-semibold">
                Inspector
              </span>
            </div>

            <span className="text-[9px] text-slate-600">
              {selected}
            </span>
          </div>

          <div className="flex-1 overflow-auto p-4">

            <div>
              <div className="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-500">
                Estructura
              </div>

              <div className="mt-3 space-y-1">
                {canvas.map((item) => (
                  <button
                    key={item.id}
                    type="button"
                    onClick={() => setSelected(item.id)}
                    className={`flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-[11px] transition ${
                      selected === item.id
                        ? "bg-cyan-400/[.08] text-cyan-300"
                        : "text-slate-400 hover:bg-white/[.03] hover:text-white"
                    }`}
                  >
                    <ChevronRight size={12} />
                    <span className="flex-1">{item.label}</span>
                  </button>
                ))}
              </div>
            </div>

            <div className="my-6 h-px bg-white/[.06]" />

            <div>
              <div className="text-[10px] font-semibold uppercase tracking-[.16em] text-slate-500">
                Propiedades
              </div>

              <div className="mt-3 space-y-4">

                <div>
                  <label className="text-[10px] text-slate-500">
                    Nombre
                  </label>

                  <input
                    value={
                      canvas.find((item) => item.id === selected)?.label ||
                      selected
                    }
                    readOnly
                    className="mt-1 w-full rounded-lg border border-white/[.07] bg-black/20 px-3 py-2 text-[11px] text-slate-300 outline-none"
                  />
                </div>

                <div>
                  <label className="text-[10px] text-slate-500">
                    Alineación
                  </label>

                  <div className="mt-1 grid grid-cols-3 gap-1">
                    {["Izq.", "Centro", "Der."].map((item) => (
                      <button
                        key={item}
                        type="button"
                        className="rounded-md border border-white/[.07] bg-black/20 px-2 py-2 text-[9px] text-slate-500 hover:text-white"
                      >
                        {item}
                      </button>
                    ))}
                  </div>
                </div>

                <div>
                  <label className="text-[10px] text-slate-500">
                    Espaciado
                  </label>

                  <div className="mt-1 grid grid-cols-2 gap-2">
                    <div className="rounded-lg border border-white/[.07] bg-black/20 px-3 py-2">
                      <div className="text-[9px] text-slate-600">
                        Padding
                      </div>
                      <div className="mt-1 text-[11px] text-slate-300">
                        24 px
                      </div>
                    </div>

                    <div className="rounded-lg border border-white/[.07] bg-black/20 px-3 py-2">
                      <div className="text-[9px] text-slate-600">
                        Margin
                      </div>
                      <div className="mt-1 text-[11px] text-slate-300">
                        0 px
                      </div>
                    </div>
                  </div>
                </div>

                <div>
                  <label className="text-[10px] text-slate-500">
                    Responsive
                  </label>

                  <div className="mt-2 rounded-lg border border-emerald-400/10 bg-emerald-400/[.03] p-3">
                    <div className="flex items-center gap-2">
                      <MousePointer2 size={13} className="text-emerald-400" />
                      <span className="text-[10px] text-emerald-300">
                        Edición visual activa
                      </span>
                    </div>

                    <p className="mt-1 text-[9px] leading-4 text-slate-600">
                      Los cambios se preparan para Desktop, Tablet y Mobile.
                    </p>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  );
}
