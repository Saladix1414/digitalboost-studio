/* ============================================================
   DIGITALBOOST
   STORE BUILDER — DESIGN UPGRADE V2
   ============================================================

   Dirección:
   - Light premium
   - DigitalBoost blue
   - Violet
   - Cyan
   - Emerald
   - Glass muy ligero
   - Canvas editorial
   - Builder profesional
   ============================================================ */


.dbf-shell {
  --dbf-bg: #f4f7fb;
  --dbf-white: #ffffff;
  --dbf-soft: #f8fafc;
  --dbf-soft-2: #eef3f8;
  --dbf-soft-blue: #eff6ff;
  --dbf-soft-violet: #f5f3ff;

  --dbf-text: #172033;
  --dbf-secondary: #475569;
  --dbf-muted: #64748b;
  --dbf-muted-2: #94a3b8;

  --dbf-border: #dde6ef;
  --dbf-border-strong: #cbd5e1;

  --dbf-blue: #2563eb;
  --dbf-blue-dark: #1d4ed8;

  --dbf-violet: #7c3aed;
  --dbf-violet-dark: #6d28d9;

  --dbf-cyan: #0891b2;
  --dbf-cyan-bright: #06b6d4;

  --dbf-green: #059669;
  --dbf-green-dark: #047857;

  position: relative;

  width: 100%;
  min-height: calc(100vh - 24px);

  color: var(--dbf-text) !important;

  background:
    radial-gradient(
      circle at 7% 0%,
      rgba(37,99,235,.07),
      transparent 27%
    ),
    radial-gradient(
      circle at 97% 9%,
      rgba(124,58,237,.07),
      transparent 25%
    ),
    linear-gradient(
      180deg,
      #fbfdff 0%,
      #f3f6fa 100%
    ) !important;

  border:
    1px solid var(--dbf-border) !important;

  border-radius:
    24px !important;

  overflow:
    hidden !important;

  box-shadow:
    0 24px 70px rgba(15,23,42,.09),
    0 4px 16px rgba(15,23,42,.035) !important;

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif !important;
}


.dbf-shell *,
.dbf-shell *::before,
.dbf-shell *::after {
  box-sizing:
    border-box;
}


/* ============================================================
   TOPBAR
   ============================================================ */

.dbf-topbar {
  position: relative;
  z-index: 10;

  min-height:
    76px;

  padding:
    11px 16px;

  display:
    grid;

  grid-template-columns:
    minmax(240px, 1fr)
    auto
    minmax(240px, 1fr);

  align-items:
    center;

  gap:
    14px;

  background:
    rgba(255,255,255,.94) !important;

  backdrop-filter:
    blur(18px);

  border-bottom:
    1px solid var(--dbf-border);

  box-shadow:
    0 8px 25px rgba(15,23,42,.035);
}


.dbf-brand-zone {
  display:
    flex;

  align-items:
    center;

  gap:
    10px;

  min-width:
    0;
}


.dbf-brand {
  display:
    flex;

  align-items:
    center;

  gap:
    10px;

  min-width:
    0;
}


.dbf-brand > div:last-child {
  min-width:
    0;

  display:
    flex;

  flex-direction:
    column;
}


.dbf-brand strong {
  color:
    #0f172a;

  font-size:
    12px;

  line-height:
    1;

  letter-spacing:
    .095em;

  font-weight:
    900;
}


.dbf-brand span {
  margin-top:
    5px;

  color:
    var(--dbf-muted);

  font-size:
    8px;

  line-height:
    1;

  letter-spacing:
    .12em;

  font-weight:
    800;
}


.dbf-brand-icon {
  position:
    relative;

  width:
    38px;

  height:
    38px;

  flex:
    0 0 38px;

  display:
    grid;

  place-items:
    center;

  border-radius:
    12px;

  background:
    linear-gradient(
      135deg,
      #eef4ff,
      #e9ddff
    );

  border:
    1px solid #c7d8ff;

  color:
    var(--dbf-violet);

  box-shadow:
    0 8px 20px rgba(99,102,241,.12);
}


.dbf-brand-icon::after {
  content:
    "";

  position:
    absolute;

  inset:
    5px;

  border:
    1px solid rgba(124,58,237,.16);

  border-radius:
    9px;

  pointer-events:
    none;
}


/* ============================================================
   ICON BUTTON
   ============================================================ */

.dbf-icon-button {
  width:
    38px;

  height:
    38px;

  flex:
    0 0 38px;

  display:
    grid;

  place-items:
    center;

  cursor:
    pointer;

  background:
    #ffffff !important;

  color:
    #334155 !important;

  border:
    1px solid var(--dbf-border-strong) !important;

  border-radius:
    10px !important;

  box-shadow:
    0 2px 8px rgba(15,23,42,.025);

  transition:
    transform .16s ease,
    box-shadow .16s ease,
    border-color .16s ease;
}


.dbf-icon-button:hover {
  transform:
    translateY(-1px);

  border-color:
    #b7c6d8 !important;

  box-shadow:
    0 7px 16px rgba(15,23,42,.07);
}


/* ============================================================
   LIVE
   ============================================================ */

.dbf-live {
  display:
    inline-flex;

  align-items:
    center;

  gap:
    6px;

  padding:
    7px 10px;

  border-radius:
    999px;

  background:
    #ecfdf5;

  color:
    #047857;

  border:
    1px solid #a7f3d0;

  font-size:
    8px;

  line-height:
    1;

  font-weight:
    900;

  letter-spacing:
    .12em;

  box-shadow:
    0 4px 12px rgba(5,150,105,.07);
}


.dbf-live > span,
.dbf-statusbar .dot {
  width:
    7px;

  height:
    7px;

  display:
    inline-block;

  flex:
    0 0 7px;

  border-radius:
    50%;

  background:
    #10b981;

  box-shadow:
    0 0 0 4px rgba(16,185,129,.10);
}


/* ============================================================
   DEVICE SWITCH
   ============================================================ */

.dbf-device-switch {
  justify-self:
    center;

  display:
    inline-flex;

  align-items:
    center;

  gap:
    3px;

  padding:
    4px;

  background:
    #f8fafc;

  border:
    1px solid var(--dbf-border);

  border-radius:
    13px;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.9);
}


.dbf-device-switch button {
  width:
    34px;

  height:
    30px;

  display:
    grid;

  place-items:
    center;

  border:
    0 !important;

  border-radius:
    8px;

  background:
    transparent !important;

  color:
    #64748b;

  cursor:
    pointer;

  transition:
    background-color .15s ease,
    color .15s ease,
    box-shadow .15s ease;
}


.dbf-device-switch button:hover {
  color:
    #334155;

  background:
    #f1f5f9 !important;
}


.dbf-device-switch button.active {
  background:
    #ffffff !important;

  color:
    var(--dbf-blue) !important;

  box-shadow:
    0 4px 10px rgba(15,23,42,.08);
}


/* ============================================================
   ACTIONS
   ============================================================ */

.dbf-actions {
  justify-self:
    end;

  display:
    flex;

  align-items:
    center;

  gap:
    7px;
}


.dbf-button {
  min-height:
    40px;

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  gap:
    7px;

  padding:
    0 12px;

  border:
    1px solid var(--dbf-border-strong) !important;

  background:
    #ffffff !important;

  color:
    #334155 !important;

  border-radius:
    10px !important;

  font-size:
    10px;

  font-weight:
    850;

  cursor:
    pointer;

  box-shadow:
    0 2px 6px rgba(15,23,42,.025);

  transition:
    transform .16s ease,
    box-shadow .16s ease,
    border-color .16s ease;
}


.dbf-button:hover {
  transform:
    translateY(-1px);

  border-color:
    #b8c7d8 !important;

  box-shadow:
    0 7px 18px rgba(15,23,42,.065);
}


.dbf-button-violet {
  color:
    #ffffff !important;

  border-color:
    transparent !important;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #6d28d9
    ) !important;

  box-shadow:
    0 9px 20px rgba(124,58,237,.20);
}


.dbf-button-violet:hover {
  border-color:
    transparent !important;

  box-shadow:
    0 12px 26px rgba(124,58,237,.25);
}


.dbf-save {
  color:
    #ffffff !important;

  border-color:
    transparent !important;

  background:
    linear-gradient(
      135deg,
      #059669,
      #047857
    ) !important;

  box-shadow:
    0 8px 18px rgba(5,150,105,.17);
}


.dbf-publish {
  color:
    #ffffff !important;

  border-color:
    transparent !important;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #1d4ed8
    ) !important;

  box-shadow:
    0 8px 18px rgba(37,99,235,.18);
}


/* ============================================================
   MAIN GRID
   ============================================================ */

.dbf-layout {
  min-height:
    calc(100vh - 100px);

  display:
    grid;

  grid-template-columns:
    262px
    minmax(0,1fr)
    306px;

  background:
    #f4f7fb;
}


/* ============================================================
   SIDEBARS
   ============================================================ */

.dbf-sidebar {
  min-width:
    0;

  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #f8fafc 100%
    ) !important;

  position:
    relative;
}


.dbf-left {
  border-right:
    1px solid var(--dbf-border);

  padding:
    17px;
}


.dbf-right {
  border-left:
    1px solid var(--dbf-border);

  padding:
    17px;
}


/* ============================================================
   PANEL HEADERS
   ============================================================ */

.dbf-panel-heading {
  display:
    flex;

  align-items:
    flex-start;

  justify-content:
    space-between;

  margin-bottom:
    16px;

  color:
    var(--dbf-text);
}


.dbf-panel-heading > div {
  display:
    flex;

  flex-direction:
    column;
}


.dbf-panel-heading span {
  color:
    var(--dbf-muted-2);

  font-size:
    8px;

  font-weight:
    900;

  letter-spacing:
    .17em;
}


.dbf-panel-heading strong {
  margin-top:
    4px;

  color:
    #172033;

  font-size:
    15px;

  font-weight:
    850;

  letter-spacing:
    -.015em;
}


/* ============================================================
   TOOL CARDS
   ============================================================ */

.dbf-tools {
  display:
    grid;

  gap:
    8px;
}


.dbf-tools button {
  position:
    relative;

  width:
    100%;

  min-height:
    52px;

  display:
    grid;

  grid-template-columns:
    36px
    minmax(0,1fr)
    14px;

  align-items:
    center;

  gap:
    9px;

  padding:
    8px;

  border:
    1px solid var(--dbf-border) !important;

  border-radius:
    12px !important;

  background:
    #ffffff !important;

  color:
    var(--dbf-text) !important;

  cursor:
    pointer;

  text-align:
    left;

  box-shadow:
    0 3px 10px rgba(15,23,42,.028);

  transition:
    transform .16s ease,
    border-color .16s ease,
    box-shadow .16s ease;
}


.dbf-tools button:hover {
  transform:
    translateY(-1px);

  border-color:
    #c4d0dc !important;

  box-shadow:
    0 8px 20px rgba(15,23,42,.065);
}


.dbf-tools button > span {
  width:
    36px;

  height:
    36px;

  display:
    grid;

  place-items:
    center;

  border-radius:
    10px;

  background:
    linear-gradient(
      135deg,
      #eef4ff,
      #f5f1ff
    );

  color:
    var(--dbf-violet);

  border:
    1px solid #e0ddff;
}


.dbf-tools strong {
  display:
    block;

  color:
    #1e293b;

  font-size:
    10px;

  line-height:
    1.2;
}


.dbf-tools small {
  display:
    block;

  margin-top:
    3px;

  color:
    var(--dbf-muted);

  font-size:
    8px;

  line-height:
    1.2;
}


/* ============================================================
   PAGES
   ============================================================ */

.dbf-separator {
  height:
    1px;

  margin:
    18px 0;

  background:
    var(--dbf-border);
}


.dbf-side-label {
  color:
    var(--dbf-muted-2);

  font-size:
    8px;

  font-weight:
    900;

  letter-spacing:
    .17em;
}


.dbf-pages {
  display:
    grid;

  gap:
    3px;

  margin-top:
    8px;
}


.dbf-pages button {
  width:
    100%;

  display:
    flex;

  align-items:
    center;

  gap:
    8px;

  padding:
    9px 8px;

  border:
    1px solid transparent;

  border-radius:
    9px;

  background:
    transparent;

  color:
    var(--dbf-muted);

  cursor:
    pointer;

  text-align:
    left;

  font-size:
    10px;

  transition:
    background-color .15s ease,
    color .15s ease,
    border-color .15s ease;
}


.dbf-pages button:hover {
  background:
    #f4f7fb;

  border-color:
    #edf2f7;
}


.dbf-pages button span {
  width:
    6px;

  height:
    6px;

  border-radius:
    50%;

  background:
    #cbd5e1;
}


.dbf-pages button.active {
  background:
    #edf4ff;

  color:
    var(--dbf-blue);

  border-color:
    #d8e7ff;

  font-weight:
    850;
}


.dbf-pages button.active span {
  background:
    var(--dbf-blue);

  box-shadow:
    0 0 0 3px rgba(37,99,235,.08);
}


.dbf-side-bottom {
  margin-top:
    18px;

  padding-top:
    14px;

  display:
    flex;

  align-items:
    center;

  gap:
    7px;

  border-top:
    1px solid var(--dbf-border);

  color:
    var(--dbf-muted);

  font-size:
    8px;
}


/* ============================================================
   CANVAS
   ============================================================ */

.dbf-canvas {
  min-width:
    0;

  display:
    flex;

  flex-direction:
    column;

  background:
    radial-gradient(
      circle at 50% 0%,
      #ffffff 0%,
      #f5f8fb 38%,
      #eef2f7 100%
    ) !important;
}


.dbf-canvas-top {
  min-height:
    64px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    12px;

  padding:
    0 18px;

  background:
    rgba(255,255,255,.74);

  border-bottom:
    1px solid var(--dbf-border);

  backdrop-filter:
    blur(12px);
}


.dbf-canvas-top > div:first-child {
  display:
    flex;

  flex-direction:
    column;
}


.dbf-canvas-top span {
  color:
    var(--dbf-muted-2);

  font-size:
    8px;

  line-height:
    1;

  font-weight:
    900;

  letter-spacing:
    .14em;
}


.dbf-canvas-top strong {
  margin-top:
    4px;

  color:
    #172033;

  font-size:
    12px;

  line-height:
    1;
}


.dbf-canvas-tools {
  display:
    flex;

  align-items:
    center;

  gap:
    6px;
}


.dbf-canvas-tools button {
  display:
    inline-flex;

  align-items:
    center;

  gap:
    6px;

  min-height:
    34px;

  padding:
    0 10px;

  border:
    1px solid var(--dbf-border);

  border-radius:
    9px;

  background:
    #ffffff;

  color:
    var(--dbf-secondary);

  font-size:
    9px;

  font-weight:
    850;

  cursor:
    pointer;

  box-shadow:
    0 2px 8px rgba(15,23,42,.025);
}


.dbf-canvas-tools button:hover {
  border-color:
    #bfccd9;
}


/* ============================================================
   CANVAS AREA
   ============================================================ */

.dbf-canvas-area {
  flex:
    1;

  min-height:
    0;

  overflow:
    auto;

  padding:
    24px;

  display:
    flex;

  justify-content:
    center;

  background:
    radial-gradient(
      circle at 50% 8%,
      rgba(255,255,255,.96),
      rgba(245,248,251,.86) 52%,
      rgba(236,241,246,.88) 100%
    );
}


.dbf-device {
  width:
    100%;

  max-width:
    1180px;

  align-self:
    flex-start;

  overflow:
    hidden;

  background:
    #ffffff !important;

  border:
    1px solid #d9e3ec;

  border-radius:
    18px;

  box-shadow:
    0 24px 55px rgba(15,23,42,.10),
    0 4px 14px rgba(15,23,42,.035);
}


.dbf-device-tablet {
  max-width:
    760px;
}


.dbf-device-mobile {
  max-width:
    390px;
}


/* ============================================================
   BROWSER BAR
   ============================================================ */

.dbf-browser-bar {
  height:
    32px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  padding:
    0 11px;

  background:
    linear-gradient(
      180deg,
      #fafbfd,
      #f4f7fa
    );

  color:
    #94a3b8;

  border-bottom:
    1px solid #e5ebf1;

  font-size:
    8px;

  font-weight:
    800;

  letter-spacing:
    .06em;
}


/* ============================================================
   SITE
   ============================================================ */

.dbf-site {
  background:
    #ffffff;

  color:
    var(--dbf-text);
}


.dbf-site-header {
  min-height:
    64px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    15px;

  padding:
    0 22px;

  background:
    rgba(255,255,255,.98);

  border-bottom:
    1px solid #edf2f6;
}


.dbf-site-logo {
  color:
    #111827;

  font-size:
    11px;

  font-weight:
    950;

  letter-spacing:
    .095em;
}


.dbf-site-logo span {
  color:
    var(--dbf-blue);
}


.dbf-site-header nav {
  display:
    flex;

  align-items:
    center;

  gap:
    22px;

  color:
    var(--dbf-muted);

  font-size:
    9px;

  font-weight:
    700;
}


.dbf-site-header nav span {
  cursor:
    default;
}


.dbf-site-header > button {
  width:
    34px;

  height:
    34px;

  position:
    relative;

  display:
    grid;

  place-items:
    center;

  border:
    1px solid var(--dbf-border);

  border-radius:
    9px;

  background:
    #ffffff;

  color:
    var(--dbf-secondary);
}


.dbf-site-header i {
  position:
    absolute;

  top:
    -5px;

  right:
    -5px;

  width:
    15px;

  height:
    15px;

  display:
    grid;

  place-items:
    center;

  border-radius:
    50%;

  background:
    var(--dbf-violet);

  color:
    #ffffff;

  font-style:
    normal;

  font-size:
    7px;

  font-weight:
    900;
}


/* ============================================================
   BLOCKS
   ============================================================ */

.dbf-block {
  position:
    relative;

  border:
    1px solid transparent;

  cursor:
    pointer;

  transition:
    border-color .16s ease,
    box-shadow .16s ease;
}


.dbf-block:hover {
  border-color:
    #cdd8e3;
}


.dbf-block.selected {
  border-color:
    #a78bfa;

  box-shadow:
    0 0 0 3px rgba(124,58,237,.075);
}


.dbf-selection {
  position:
    absolute;

  z-index:
    3;

  top:
    10px;

  left:
    10px;

  display:
    inline-flex;

  align-items:
    center;

  gap:
    5px;

  padding:
    5px 8px;

  border:
    1px solid #ddd6fe;

  border-radius:
    8px;

  background:
    rgba(255,255,255,.96);

  color:
    var(--dbf-violet);

  font-size:
    8px;

  font-weight:
    850;

  box-shadow:
    0 5px 14px rgba(15,23,42,.08);

  backdrop-filter:
    blur(8px);
}


.dbf-block-actions {
  position:
    absolute;

  top:
    10px;

  right:
    10px;

  z-index:
    4;
}


.dbf-block-actions button {
  width:
    26px;

  height:
    26px;

  display:
    grid;

  place-items:
    center;

  border:
    1px solid var(--dbf-border);

  border-radius:
    8px;

  background:
    rgba(255,255,255,.96);

  color:
    #ef4444;

  font-size:
    15px;

  cursor:
    pointer;

  box-shadow:
    0 4px 12px rgba(15,23,42,.06);
}


/* ============================================================
   HERO
   ============================================================ */

.dbf-main-hero {
  min-height:
    430px;

  display:
    grid;

  grid-template-columns:
    1.04fr .96fr;

  align-items:
    center;

  gap:
    28px;

  padding:
    68px 56px 58px;

  background:
    radial-gradient(
      circle at 80% 35%,
      rgba(37,99,235,.08),
      transparent 28%
    ),
    radial-gradient(
      circle at 84% 72%,
      rgba(124,58,237,.07),
      transparent 25%
    ),
    linear-gradient(
      135deg,
      #fbfdff 0%,
      #eff5ff 58%,
      #faf7ff 100%
    );
}


.dbf-small-pill,
.dbf-preview-pill {
  display:
    inline-flex;

  align-items:
    center;

  gap:
    6px;

  width:
    max-content;

  padding:
    6px 9px;

  border:
    1px solid #dce5ff;

  border-radius:
    999px;

  background:
    linear-gradient(
      135deg,
      #f2f5ff,
      #f8f2ff
    );

  color:
    var(--dbf-violet);

  font-size:
    8px;

  font-weight:
    950;

  letter-spacing:
    .12em;
}


.dbf-main-hero h1 {
  margin:
    19px 0 14px;

  max-width:
    620px;

  color:
    #101828;

  font-size:
    clamp(38px, 4vw, 58px);

  line-height:
    .99;

  letter-spacing:
    -.055em;

  font-weight:
    900;
}


.dbf-main-hero h1 span {
  color:
    var(--dbf-blue);
}


.dbf-main-hero p {
  max-width:
    480px;

  margin:
    0;

  color:
    var(--dbf-muted);

  font-size:
    12px;

  line-height:
    1.75;
}


.dbf-main-buttons,
.dbf-preview-cta-row {
  display:
    flex;

  flex-wrap:
    wrap;

  gap:
    9px;

  margin-top:
    23px;
}


.dbf-main-buttons button,
.dbf-preview-cta-row button {
  min-height:
    40px;

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  gap:
    7px;

  padding:
    0 15px;

  border:
    0;

  border-radius:
    10px;

  background:
    linear-gradient(
      135deg,
      var(--dbf-blue),
      var(--dbf-blue-dark)
    );

  color:
    #ffffff;

  font-size:
    9px;

  font-weight:
    900;

  box-shadow:
    0 9px 22px rgba(37,99,235,.18);
}


.dbf-main-buttons .secondary,
.dbf-preview-cta-row .secondary {
  background:
    #ffffff !important;

  color:
    var(--dbf-secondary) !important;

  border:
    1px solid var(--dbf-border-strong) !important;

  box-shadow:
    none;
}


/* ============================================================
   HERO OBJECT
   ============================================================ */

.dbf-hero-object {
  min-height:
    270px;

  position:
    relative;

  display:
    grid;

  place-items:
    center;
}


.orb {
  position:
    absolute;

  border:
    1px solid rgba(37,99,235,.16);

  border-radius:
    50%;

  box-shadow:
    inset 0 0 25px rgba(37,99,235,.035);
}


.orb-1 {
  width:
    245px;

  height:
    245px;
}


.orb-2 {
  width:
    164px;

  height:
    164px;

  border-color:
    rgba(124,58,237,.18);
}


.hero-card {
  position:
    relative;

  width:
    180px;

  height:
    192px;

  display:
    flex;

  flex-direction:
    column;

  justify-content:
    center;

  align-items:
    center;

  gap:
    8px;

  border:
    1px solid #dae5f0;

  border-radius:
    20px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #eff5ff 63%,
      #f8f3ff
    );

  color:
    var(--dbf-blue);

  box-shadow:
    0 28px 55px rgba(37,99,235,.11),
    0 5px 15px rgba(15,23,42,.045);

  transform:
    rotate(-3deg);
}


.hero-card::before {
  content:
    "";

  position:
    absolute;

  inset:
    10px;

  border:
    1px solid rgba(37,99,235,.10);

  border-radius:
    15px;
}


.hero-card strong {
  position:
    relative;

  color:
    #172033;

  font-size:
    19px;

  font-weight:
    950;
}


.hero-card span {
  position:
    relative;

  color:
    var(--dbf-muted);

  font-size:
    8px;

  font-weight:
    850;

  letter-spacing:
    .17em;
}


/* ============================================================
   FEATURE STRIP
   ============================================================ */

.dbf-feature-strip,
.dbf-preview-features {
  display:
    grid;

  grid-template-columns:
    repeat(3,1fr);

  gap:
    1px;

  background:
    #e8edf3;

  border-top:
    1px solid #e8edf3;

  border-bottom:
    1px solid #e8edf3;
}


.dbf-feature-strip > div,
.dbf-preview-features > div {
  padding:
    23px;

  background:
    #ffffff;
}


.dbf-feature-strip strong,
.dbf-preview-features strong {
  display:
    block;

  color:
    var(--dbf-text);

  font-size:
    10px;

  font-weight:
    900;
}


.dbf-feature-strip span,
.dbf-preview-features span {
  display:
    block;

  margin-top:
    5px;

  color:
    var(--dbf-muted);

  font-size:
    8px;

  line-height:
    1.45;
}


/* ============================================================
   PRODUCTS
   ============================================================ */

.dbf-products,
.dbf-preview-products {
  background:
    #ffffff;
}


.dbf-products {
  padding:
    30px;
}


.dbf-products-heading {
  display:
    flex;

  align-items:
    flex-end;

  justify-content:
    space-between;

  gap:
    14px;

  margin-bottom:
    17px;
}


.dbf-products-heading > div {
  display:
    flex;

  flex-direction:
    column;
}


.dbf-products-heading span:first-child {
  color:
    var(--dbf-blue);

  font-size:
    8px;

  font-weight:
    950;

  letter-spacing:
    .15em;
}


.dbf-products-heading strong {
  margin-top:
    4px;

  color:
    var(--dbf-text);

  font-size:
    18px;

  font-weight:
    900;

  letter-spacing:
    -.02em;
}


.dbf-products-heading > span:last-child {
  color:
    var(--dbf-muted);

  font-size:
    9px;

  font-weight:
    800;
}


.dbf-product-grid,
.dbf-preview-products {
  display:
    grid;

  grid-template-columns:
    repeat(3,1fr);

  gap:
    15px;
}


.dbf-product-grid article,
.dbf-preview-products article {
  padding:
    8px;

  border:
    1px solid #e6edf3;

  border-radius:
    13px;

  background:
    #ffffff;

  box-shadow:
    0 4px 14px rgba(15,23,42,.028);

  transition:
    transform .16s ease,
    box-shadow .16s ease,
    border-color .16s ease;
}


.dbf-product-grid article:hover,
.dbf-preview-products article:hover {
  transform:
    translateY(-2px);

  border-color:
    #d5e1eb;

  box-shadow:
    0 12px 24px rgba(15,23,42,.065);
}


.dbf-card-image,
.dbf-product-art {
  min-height:
    150px;

  border-radius:
    10px;

  background:
    linear-gradient(
      135deg,
      #e7f0ff,
      #f3eaff
    );
}


.card-2,
.art-2 {
  background:
    linear-gradient(
      135deg,
      #e9faf4,
      #e7f0ff
    );
}


.card-3,
.art-3 {
  background:
    linear-gradient(
      135deg,
      #fff4e7,
      #f0eaff
    );
}


.dbf-product-grid span,
.dbf-preview-products article > span {
  display:
    block;

  margin:
    9px 2px 5px;

  color:
    var(--dbf-muted);

  font-size:
    8px;
}


.dbf-product-grid strong,
.dbf-preview-products article > strong {
  color:
    var(--dbf-text);

  font-size:
    10px;

  font-weight:
    900;
}


/* ============================================================
   STORY
   ============================================================ */

.dbf-story {
  padding:
    55px;

  background:
    radial-gradient(
      circle at 90% 30%,
      rgba(124,58,237,.09),
      transparent 25%
    ),
    linear-gradient(
      135deg,
      #fbfcff,
      #f6f2ff
    );
}


.dbf-story > span {
  color:
    var(--dbf-violet);

  font-size:
    8px;

  font-weight:
    950;

  letter-spacing:
    .15em;
}


.dbf-story h2 {
  max-width:
    670px;

  margin:
    12px 0;

  color:
    var(--dbf-text);

  font-size:
    30px;

  line-height:
    1.08;

  letter-spacing:
    -.035em;

  font-weight:
    900;
}


.dbf-story p {
  max-width:
    650px;

  color:
    var(--dbf-muted);

  font-size:
    11px;

  line-height:
    1.75;
}


/* ============================================================
   STATUS BAR
   ============================================================ */

.dbf-statusbar {
  min-height:
    38px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    10px;

  padding:
    0 15px;

  border-top:
    1px solid var(--dbf-border);

  background:
    rgba(255,255,255,.88);

  color:
    var(--dbf-muted);

  font-size:
    8px;

  font-weight:
    800;
}


.dbf-statusbar > span:first-child {
  display:
    flex;

  align-items:
    center;

  gap:
    7px;
}


/* ============================================================
   INSPECTOR
   ============================================================ */

.dbf-inspector-selected {
  display:
    flex;

  align-items:
    center;

  gap:
    9px;

  margin-bottom:
    16px;

  padding:
    11px;

  border:
    1px solid var(--dbf-border);

  border-radius:
    12px;

  background:
    linear-gradient(
      135deg,
      #ffffff,
      #fbfcff
    );

  box-shadow:
    0 4px 12px rgba(15,23,42,.03);
}


.dbf-inspector-selected > div {
  width:
    33px;

  height:
    33px;

  display:
    grid;

  place-items:
    center;

  border-radius:
    9px;

  background:
    linear-gradient(
      135deg,
      #f1edff,
      #edf5ff
    );

  color:
    var(--dbf-violet);

  border:
    1px solid #e0dbff;
}


.dbf-inspector-selected section {
  display:
    flex;

  flex-direction:
    column;
}


.dbf-inspector-selected strong {
  color:
    var(--dbf-text);

  font-size:
    10px;

  font-weight:
    900;
}


.dbf-inspector-selected span {
  margin-top:
    3px;

  color:
    var(--dbf-muted);

  font-size:
    8px;
}


/* fields */

.dbf-field {
  display:
    block;

  margin-bottom:
    15px;
}


.dbf-field > span,
.dbf-inspector-section > span {
  display:
    block;

  margin-bottom:
    7px;

  color:
    #94a3b8;

  font-size:
    8px;

  font-weight:
    950;

  letter-spacing:
    .13em;
}


.dbf-field input,
.dbf-field textarea {
  width:
    100%;

  border:
    1px solid var(--dbf-border-strong) !important;

  border-radius:
    10px !important;

  background:
    #ffffff !important;

  color:
    var(--dbf-text) !important;

  padding:
    9px 10px;

  font:
    inherit;

  font-size:
    9px;

  outline:
    none;

  box-shadow:
    0 1px 2px rgba(15,23,42,.02);

  transition:
    border-color .15s ease,
    box-shadow .15s ease;
}


.dbf-field input:focus,
.dbf-field textarea:focus {
  border-color:
    #93c5fd !important;

  box-shadow:
    0 0 0 3px rgba(37,99,235,.09);
}


.dbf-inspector-section {
  padding:
    15px 0;

  border-top:
    1px solid var(--dbf-border);
}


.dbf-palette {
  display:
    flex;

  gap:
    8px;
}


.dbf-palette i {
  width:
    20px;

  height:
    20px;

  border-radius:
    7px;

  border:
    2px solid #ffffff;

  box-shadow:
    0 0 0 1px #dbe3ec,
    0 3px 8px rgba(15,23,42,.08);
}


.dbf-color-violet {
  background:
    #7c3aed;
}


.dbf-color-blue {
  background:
    #2563eb;
}


.dbf-color-cyan {
  background:
    #0891b2;
}


.dbf-color-green {
  background:
    #059669;
}


.dbf-slider-label {
  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  color:
    var(--dbf-secondary);

  font-size:
    9px;

  font-weight:
    750;
}


.dbf-slider-label strong {
  color:
    var(--dbf-text);

  font-size:
    9px;
}


.dbf-range {
  width:
    100%;

  margin-top:
    10px;

  accent-color:
    var(--dbf-blue);
}


/* ============================================================
   AI ACTION
   ============================================================ */

.dbf-ai {
  width:
    100%;

  display:
    grid;

  grid-template-columns:
    30px
    minmax(0,1fr)
    14px;

  align-items:
    center;

  gap:
    8px;

  padding:
    11px;

  border:
    1px solid #cfc7f8;

  border-radius:
    12px;

  background:
    linear-gradient(
      135deg,
      #fbf8ff,
      #f1f9ff
    );

  color:
    var(--dbf-violet);

  cursor:
    pointer;

  text-align:
    left;

  box-shadow:
    0 6px 16px rgba(124,58,237,.07);
}


.dbf-ai > svg:first-child {
  width:
    30px;

  height:
    30px;

  padding:
    7px;

  border-radius:
    8px;

  background:
    #ffffff;
}


.dbf-ai > div {
  min-width:
    0;

  display:
    flex;

  flex-direction:
    column;
}


.dbf-ai strong {
  font-size:
    9px;

  font-weight:
    900;
}


.dbf-ai span {
  margin-top:
    3px;

  color:
    var(--dbf-muted);

  font-size:
    8px;

  line-height:
    1.3;
}


/* ============================================================
   PREVIEW
   ============================================================ */

.dbf-preview-shell {
  min-height:
    calc(100vh - 24px);

  background:
    radial-gradient(
      circle at 8% 0%,
      rgba(37,99,235,.065),
      transparent 25%
    ),
    radial-gradient(
      circle at 96% 6%,
      rgba(124,58,237,.065),
      transparent 22%
    ),
    linear-gradient(
      180deg,
      #f8fafc,
      #eef2f7
    ) !important;
}


.dbf-preview-header {
  min-height:
    76px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    15px;

  padding:
    0 20px;

  background:
    rgba(255,255,255,.96);

  border-bottom:
    1px solid var(--dbf-border);

  backdrop-filter:
    blur(16px);
}


.dbf-preview-header > div {
  display:
    flex;

  flex-direction:
    column;
}


.dbf-preview-header h2 {
  margin:
    4px 0 0;

  color:
    var(--dbf-text);

  font-size:
    15px;

  font-weight:
    900;
}


.dbf-kicker {
  color:
    var(--dbf-blue);

  font-size:
    8px;

  font-weight:
    950;

  letter-spacing:
    .16em;
}


.dbf-preview-stage {
  padding:
    28px;

  display:
    flex;

  justify-content:
    center;

  background:
    radial-gradient(
      circle at top,
      #ffffff,
      #eef2f7 78%
    );
}


.dbf-store-preview {
  width:
    min(1160px,100%);

  overflow:
    hidden;

  background:
    #ffffff;

  border:
    1px solid var(--dbf-border);

  border-radius:
    20px;

  box-shadow:
    0 28px 70px rgba(15,23,42,.11);
}


.dbf-preview-accent {
  height:
    4px;

  background:
    linear-gradient(
      90deg,
      var(--dbf-blue),
      var(--dbf-violet),
      var(--dbf-cyan)
    );
}


.dbf-preview-nav {
  min-height:
    64px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    15px;

  padding:
    0 28px;

  background:
    #ffffff;

  border-bottom:
    1px solid #eef2f7;
}


.dbf-preview-logo {
  color:
    #111827;

  font-size:
    11px;

  font-weight:
    950;

  letter-spacing:
    .095em;
}


.dbf-preview-logo span {
  color:
    var(--dbf-blue);
}


.dbf-preview-nav nav {
  display:
    flex;

  align-items:
    center;

  gap:
    20px;

  color:
    var(--dbf-muted);

  font-size:
    9px;

  font-weight:
    700;
}


.dbf-preview-bag {
  width:
    32px;

  height:
    32px;

  display:
    grid;

  place-items:
    center;

  border:
    1px solid var(--dbf-border);

  border-radius:
    9px;

  background:
    #ffffff;

  color:
    var(--dbf-secondary);
}


.dbf-preview-hero {
  padding:
    82px 60px 68px;

  background:
    radial-gradient(
      circle at 81% 43%,
      rgba(37,99,235,.08),
      transparent 24%
    ),
    radial-gradient(
      circle at 91% 8%,
      rgba(124,58,237,.07),
      transparent 18%
    ),
    linear-gradient(
      135deg,
      #fbfdff 0%,
      #f5f1ff 100%
    );
}


.dbf-preview-hero h1 {
  margin:
    18px 0 14px;

  color:
    var(--dbf-text);

  font-size:
    clamp(42px, 5vw, 62px);

  line-height:
    .98;

  letter-spacing:
    -.05em;

  font-weight:
    900;
}


.dbf-preview-hero h1 span {
  color:
    var(--dbf-blue);
}


.dbf-preview-hero p {
  max-width:
    560px;

  color:
    var(--dbf-muted);

  font-size:
    12px;

  line-height:
    1.75;
}


/* ============================================================
   FOCUS / ACCESSIBILITY
   ============================================================ */

.dbf-shell button:focus-visible,
.dbf-shell input:focus-visible,
.dbf-shell textarea:focus-visible {
  outline:
    2px solid rgba(37,99,235,.35);

  outline-offset:
    2px;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1120px) {

  .dbf-topbar {
    grid-template-columns:
      minmax(220px,1fr)
      auto
      auto;
  }

  .dbf-layout {
    grid-template-columns:
      220px
      minmax(0,1fr)
      250px;
  }

  .dbf-main-hero {
    padding:
      54px 32px 46px;
  }

  .dbf-main-hero h1 {
    font-size:
      40px;
  }
}


@media (max-width: 900px) {

  .dbf-topbar {
    grid-template-columns:
      1fr
      auto;

    min-height:
      auto;

    padding:
      11px;
  }

  .dbf-device-switch {
    justify-self:
      end;
  }

  .dbf-actions {
    grid-column:
      1 / -1;

    justify-self:
      stretch;

    width:
      100%;
  }

  .dbf-button {
    flex:
      1;
  }

  .dbf-layout {
    display:
      block;
  }

  .dbf-left,
  .dbf-right {
    border:
      0;

    border-bottom:
      1px solid var(--dbf-border);
  }

  .dbf-right {
    border-top:
      1px solid var(--dbf-border);

    border-bottom:
      0;
  }

  .dbf-main-hero {
    grid-template-columns:
      1fr;
  }

  .dbf-hero-object {
    min-height:
      220px;
  }
}


@media (max-width: 640px) {

  .dbf-shell,
  .dbf-preview-shell {
    border-radius:
      14px !important;
  }

  .dbf-brand span,
  .dbf-live {
    display:
      none;
  }

  .dbf-canvas-area,
  .dbf-preview-stage {
    padding:
      14px;
  }

  .dbf-main-hero {
    padding:
      42px 20px 34px;
  }

  .dbf-main-hero h1 {
    font-size:
      31px;
  }

  .dbf-feature-strip,
  .dbf-product-grid,
  .dbf-preview-features,
  .dbf-preview-products {
    grid-template-columns:
      1fr;
  }

  .dbf-story {
    padding:
      35px 20px;
  }

  .dbf-story h2 {
    font-size:
      24px;
  }

  .dbf-preview-hero {
    padding:
      50px 22px;
  }

  .dbf-preview-hero h1 {
    font-size:
      40px;
  }

  .dbf-preview-nav {
    padding:
      0 18px;
  }

  .dbf-preview-nav nav {
    display:
      none;
  }
}
