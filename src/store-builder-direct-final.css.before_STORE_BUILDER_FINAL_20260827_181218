/* ============================================================
   DIGITALBOOST STORE BUILDER
   FINAL VISUAL SYSTEM V3
   ============================================================ */

:root {
  --dbf-bg: #07111f;
  --dbf-bg-2: #0b1729;
  --dbf-panel: #0f1d31;
  --dbf-panel-2: #12243b;
  --dbf-panel-3: #162a45;

  --dbf-border: rgba(148,163,184,.16);
  --dbf-border-strong: rgba(148,163,184,.27);

  --dbf-text: #f8fafc;
  --dbf-text-2: #dbe7f5;
  --dbf-muted: #91a4bd;
  --dbf-muted-2: #647893;

  --dbf-blue: #3b82f6;
  --dbf-blue-dark: #2563eb;
  --dbf-violet: #8b5cf6;
  --dbf-cyan: #06b6d4;
  --dbf-green: #10b981;
  --dbf-pink: #ec4899;
  --dbf-orange: #f59e0b;

  --dbf-shadow:
    0 24px 70px rgba(0,0,0,.32);

  --dbf-shadow-soft:
    0 10px 30px rgba(0,0,0,.20);
}

* {
  box-sizing: border-box;
}

.dbf-shell {
  width: 100%;
  min-height: 100%;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 12% 0%,
      rgba(59,130,246,.18),
      transparent 28%
    ),
    radial-gradient(
      circle at 92% 4%,
      rgba(139,92,246,.16),
      transparent 27%
    ),
    linear-gradient(
      135deg,
      #050b14 0%,
      #091525 48%,
      #0a1220 100%
    );

  color: var(--dbf-text);
}

/* ============================================================
   TOPBAR
   ============================================================ */

.dbf-topbar {
  min-height: 70px;

  display: grid;

  grid-template-columns:
    minmax(220px, 1fr)
    auto
    minmax(260px, 1fr);

  align-items: center;
  gap: 18px;

  padding: 0 18px;

  background:
    linear-gradient(
      180deg,
      rgba(16,29,49,.97),
      rgba(8,18,32,.97)
    );

  border-bottom:
    1px solid var(--dbf-border-strong);

  box-shadow:
    0 12px 35px rgba(0,0,0,.24);

  backdrop-filter: blur(18px);

  position: relative;
  z-index: 20;
}

.dbf-brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.dbf-brand::before {
  content: "D";

  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      var(--dbf-blue),
      var(--dbf-violet)
    );

  color: white;

  font-size: 15px;
  font-weight: 950;

  box-shadow:
    0 8px 25px rgba(59,130,246,.28);
}

.dbf-brand strong {
  color: #ffffff;
  font-size: 13px;
  font-weight: 950;
  letter-spacing: -.02em;
}

.dbf-brand span {
  display: block;
  margin-top: 3px;
  color: var(--dbf-muted);
  font-size: 8px;
  font-weight: 750;
}

.dbf-live {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  padding: 7px 11px;

  border:
    1px solid rgba(16,185,129,.25);

  border-radius: 999px;

  background:
    rgba(16,185,129,.08);

  color: #6ee7b7;

  font-size: 8px;
  font-weight: 900;
  letter-spacing: .10em;
}

.dbf-live::before {
  content: "";

  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: var(--dbf-green);

  box-shadow:
    0 0 0 4px rgba(16,185,129,.10),
    0 0 14px rgba(16,185,129,.7);
}

.dbf-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 7px;
}

.dbf-button {
  min-height: 36px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  padding: 0 13px;

  border:
    1px solid var(--dbf-border-strong);

  border-radius: 9px;

  background:
    rgba(255,255,255,.045);

  color: var(--dbf-text-2);

  font-size: 9px;
  font-weight: 850;

  cursor: pointer;

  transition:
    transform .15s ease,
    background .15s ease,
    border-color .15s ease,
    box-shadow .15s ease;
}

.dbf-button:hover {
  transform: translateY(-1px);

  background:
    rgba(255,255,255,.08);

  border-color:
    rgba(148,163,184,.40);
}

.dbf-button.primary {
  border-color: rgba(59,130,246,.55);

  background:
    linear-gradient(
      135deg,
      var(--dbf-blue),
      var(--dbf-violet)
    );

  color: #ffffff;

  box-shadow:
    0 8px 25px rgba(59,130,246,.22);
}

.dbf-button.primary:hover {
  box-shadow:
    0 12px 30px rgba(59,130,246,.32);
}

.dbf-device-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3px;

  padding: 3px;

  border:
    1px solid var(--dbf-border);

  border-radius: 10px;

  background:
    rgba(0,0,0,.18);
}

.dbf-device-switch button {
  min-width: 34px;
  height: 30px;

  border: 0;
  border-radius: 7px;

  background: transparent;

  color: var(--dbf-muted);

  cursor: pointer;

  font-size: 9px;
  font-weight: 850;
}

.dbf-device-switch button:hover {
  color: white;
  background: rgba(255,255,255,.06);
}

.dbf-device-switch button.active {
  color: #ffffff;

  background:
    linear-gradient(
      135deg,
      rgba(59,130,246,.85),
      rgba(139,92,246,.85)
    );

  box-shadow:
    0 5px 14px rgba(59,130,246,.20);
}

/* ============================================================
   MAIN LAYOUT
   ============================================================ */

.dbf-layout {
  min-height: calc(100vh - 70px);

  display: grid;

  grid-template-columns:
    225px
    minmax(0,1fr)
    285px;
}

/* ============================================================
   LEFT SIDEBAR
   ============================================================ */

.dbf-left {
  min-width: 0;

  padding: 18px 13px;

  background:
    linear-gradient(
      180deg,
      #0c192c,
      #091424
    );

  border-right:
    1px solid var(--dbf-border);
}

.dbf-left::-webkit-scrollbar,
.dbf-right::-webkit-scrollbar,
.dbf-canvas-area::-webkit-scrollbar {
  width: 7px;
}

.dbf-left::-webkit-scrollbar-thumb,
.dbf-right::-webkit-scrollbar-thumb,
.dbf-canvas-area::-webkit-scrollbar-thumb {
  background: rgba(148,163,184,.22);
  border-radius: 99px;
}

.dbf-side-label {
  color: var(--dbf-muted-2);

  font-size: 8px;
  font-weight: 950;

  letter-spacing: .16em;
}

.dbf-tools {
  display: grid;
  gap: 7px;

  margin-top: 10px;
}

.dbf-tools button {
  width: 100%;

  min-height: 49px;

  display: grid;

  grid-template-columns:
    32px
    minmax(0,1fr);

  align-items: center;

  gap: 9px;

  padding: 7px;

  border:
    1px solid transparent;

  border-radius: 11px;

  background:
    rgba(255,255,255,.025);

  color: var(--dbf-muted);

  cursor: pointer;

  text-align: left;

  transition:
    background .15s ease,
    border-color .15s ease,
    transform .15s ease;
}

.dbf-tools button:hover {
  transform: translateX(2px);

  background:
    rgba(59,130,246,.07);

  border-color:
    rgba(59,130,246,.20);

  color: #ffffff;
}

.dbf-tools button.active {
  background:
    linear-gradient(
      135deg,
      rgba(59,130,246,.16),
      rgba(139,92,246,.12)
    );

  border-color:
    rgba(96,165,250,.32);

  color: #ffffff;

  box-shadow:
    inset 3px 0 0 var(--dbf-blue),
    0 8px 22px rgba(0,0,0,.12);
}

.dbf-tools button > span:first-child {
  width: 32px;
  height: 32px;

  display: grid;
  place-items: center;

  border-radius: 9px;

  background:
    rgba(255,255,255,.055);

  color: #93c5fd;

  font-size: 13px;
  font-weight: 900;
}

.dbf-tools button.active > span:first-child {
  background:
    linear-gradient(
      135deg,
      rgba(59,130,246,.26),
      rgba(139,92,246,.26)
    );

  color: #ffffff;
}

.dbf-tools button strong {
  display: block;

  color: inherit;

  font-size: 9px;
  font-weight: 900;
}

.dbf-tools button small {
  display: block;

  margin-top: 3px;

  color: var(--dbf-muted-2);

  font-size: 7px;
}

.dbf-separator {
  height: 1px;

  margin: 18px 0;

  background:
    var(--dbf-border);
}

.dbf-pages {
  display: grid;
  gap: 4px;

  margin-top: 8px;
}

.dbf-pages button {
  width: 100%;

  display: flex;
  align-items: center;

  gap: 8px;

  padding: 9px 8px;

  border:
    1px solid transparent;

  border-radius: 9px;

  background: transparent;

  color: var(--dbf-muted);

  cursor: pointer;

  text-align: left;

  font-size: 9px;
  font-weight: 700;
}

.dbf-pages button:hover {
  background: rgba(255,255,255,.04);

  border-color:
    var(--dbf-border);
}

.dbf-pages button span {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #52657e;
}

.dbf-pages button.active {
  background:
    rgba(59,130,246,.10);

  color: #bfdbfe;

  border-color:
    rgba(59,130,246,.22);

  font-weight: 850;
}

.dbf-pages button.active span {
  background: var(--dbf-blue);

  box-shadow:
    0 0 0 3px rgba(59,130,246,.10),
    0 0 12px rgba(59,130,246,.7);
}

.dbf-side-bottom {
  margin-top: 18px;

  padding-top: 14px;

  display: flex;
  align-items: center;

  gap: 7px;

  border-top:
    1px solid var(--dbf-border);

  color: var(--dbf-muted-2);

  font-size: 8px;
}

/* ============================================================
   CANVAS
   ============================================================ */

.dbf-canvas {
  min-width: 0;

  display: flex;
  flex-direction: column;

  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(59,130,246,.08),
      transparent 34%
    ),
    linear-gradient(
      180deg,
      #101d31,
      #0a1525
    );
}

.dbf-canvas-top {
  min-height: 64px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  padding: 0 18px;

  background:
    rgba(12,26,44,.86);

  border-bottom:
    1px solid var(--dbf-border);

  backdrop-filter: blur(15px);
}

.dbf-canvas-top > div:first-child {
  display: flex;
  flex-direction: column;
}

.dbf-canvas-top span {
  color: var(--dbf-muted-2);

  font-size: 8px;
  line-height: 1;

  font-weight: 900;

  letter-spacing: .14em;
}

.dbf-canvas-top strong {
  margin-top: 5px;

  color: #f8fafc;

  font-size: 12px;
  line-height: 1;
}

.dbf-canvas-tools {
  display: flex;
  align-items: center;

  gap: 6px;
}

.dbf-canvas-tools button {
  min-height: 34px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 6px;

  padding: 0 10px;

  border:
    1px solid var(--dbf-border-strong);

  border-radius: 9px;

  background:
    rgba(255,255,255,.045);

  color: var(--dbf-text-2);

  font-size: 9px;
  font-weight: 850;

  cursor: pointer;
}

.dbf-canvas-tools button:hover {
  background:
    rgba(59,130,246,.08);

  border-color:
    rgba(59,130,246,.32);

  color: #ffffff;
}

/* ============================================================
   CANVAS AREA
   ============================================================ */

.dbf-canvas-area {
  flex: 1;

  min-height: 0;

  overflow: auto;

  padding: 25px;

  display: flex;

  justify-content: center;

  align-items: flex-start;

  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(59,130,246,.09),
      transparent 35%
    ),
    radial-gradient(
      circle at 20% 80%,
      rgba(139,92,246,.06),
      transparent 25%
    );
}

.dbf-device {
  width: 100%;

  max-width: 1180px;

  align-self: flex-start;

  overflow: hidden;

  background: #ffffff;

  border:
    1px solid rgba(148,163,184,.30);

  border-radius: 18px;

  box-shadow:
    0 35px 90px rgba(0,0,0,.42),
    0 5px 18px rgba(0,0,0,.22);
}

.dbf-device-tablet {
  max-width: 760px;
}

.dbf-device-mobile {
  max-width: 390px;
}

/* ============================================================
   BROWSER BAR
   ============================================================ */

.dbf-browser-bar {
  height: 32px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 11px;

  background:
    linear-gradient(
      180deg,
      #1d2939,
      #111c2c
    );

  color: #9fb0c5;

  border-bottom:
    1px solid #2b3a4e;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: .06em;
}

.dbf-browser-bar::before {
  content: "●  ●  ●";

  color: #64748b;

  letter-spacing: 4px;

  font-size: 7px;
}

/* ============================================================
   SITE PREVIEW
   ============================================================ */

.dbf-site {
  background: #ffffff;
  color: #111827;
}

.dbf-site-header {
  min-height: 64px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 0 22px;

  background:
    rgba(255,255,255,.98);

  border-bottom:
    1px solid #e7edf4;
}

.dbf-site-logo {
  color: #111827;

  font-size: 11px;
  font-weight: 950;

  letter-spacing: .095em;
}

.dbf-site-logo span {
  color: var(--dbf-blue);
}

.dbf-site-header nav {
  display: flex;
  align-items: center;

  gap: 22px;

  color: #64748b;

  font-size: 9px;
  font-weight: 750;
}

.dbf-site-header nav span {
  cursor: default;
}

.dbf-site-header > button {
  width: 34px;
  height: 34px;

  position: relative;

  display: grid;
  place-items: center;

  border:
    1px solid #dbe4ee;

  border-radius: 9px;

  background: #ffffff;

  color: #334155;
}

.dbf-site-header i {
  position: absolute;

  top: -5px;
  right: -5px;

  width: 15px;
  height: 15px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      var(--dbf-violet),
      var(--dbf-pink)
    );

  color: #ffffff;

  font-style: normal;

  font-size: 7px;
  font-weight: 900;
}

/* ============================================================
   BLOCKS
   ============================================================ */

.dbf-block {
  position: relative;

  border:
    1px solid transparent;

  cursor: pointer;

  transition:
    border-color .16s ease,
    box-shadow .16s ease,
    transform .16s ease;
}

.dbf-block:hover {
  border-color: #93c5fd;

  box-shadow:
    inset 0 0 0 1px rgba(59,130,246,.10);
}

.dbf-block.selected {
  border-color: #8b5cf6;

  box-shadow:
    0 0 0 3px rgba(139,92,246,.12),
    inset 0 0 0 1px rgba(139,92,246,.12);
}

.dbf-selection {
  position: absolute;

  z-index: 3;

  top: 10px;
  left: 10px;

  display: inline-flex;
  align-items: center;

  gap: 5px;

  padding: 5px 8px;

  border:
    1px solid #c4b5fd;

  border-radius: 8px;

  background:
    rgba(255,255,255,.96);

  color: #7c3aed;

  font-size: 8px;
  font-weight: 850;

  box-shadow:
    0 5px 14px rgba(15,23,42,.10);

  backdrop-filter: blur(8px);
}

.dbf-block-actions {
  position: absolute;

  top: 10px;
  right: 10px;

  z-index: 4;
}

.dbf-block-actions button {
  width: 28px;
  height: 28px;

  display: grid;
  place-items: center;

  border:
    1px solid #e0e7ef;

  border-radius: 8px;

  background:
    rgba(255,255,255,.96);

  color: #ef4444;

  font-size: 15px;

  cursor: pointer;

  box-shadow:
    0 5px 15px rgba(15,23,42,.08);
}

/* ============================================================
   HERO
   ============================================================ */

.dbf-main-hero {
  min-height: 430px;

  display: grid;

  grid-template-columns:
    1.04fr
    .96fr;

  align-items: center;

  gap: 28px;

  padding: 68px 56px 58px;

  background:
    radial-gradient(
      circle at 80% 35%,
      rgba(37,99,235,.17),
      transparent 28%
    ),
    radial-gradient(
      circle at 84% 72%,
      rgba(139,92,246,.16),
      transparent 25%
    ),
    radial-gradient(
      circle at 60% 90%,
      rgba(6,182,212,.10),
      transparent 25%
    ),
    linear-gradient(
      135deg,
      #eef5ff 0%,
      #f7f2ff 56%,
      #eefcff 100%
    );
}

.dbf-small-pill,
.dbf-preview-pill {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  width: max-content;

  padding: 7px 10px;

  border:
    1px solid #d5ddff;

  border-radius: 999px;

  background:
    linear-gradient(
      135deg,
      #edf3ff,
      #f6edff
    );

  color: #6d28d9;

  font-size: 8px;
  font-weight: 950;

  letter-spacing: .12em;
}

.dbf-main-hero h1 {
  margin: 19px 0 14px;

  max-width: 620px;

  color: #0f172a;

  font-size: clamp(38px, 4vw, 58px);

  line-height: .99;

  letter-spacing: -.055em;

  font-weight: 900;
}

.dbf-main-hero h1 span {
  background:
    linear-gradient(
      90deg,
      #2563eb,
      #7c3aed,
      #0891b2
    );

  -webkit-background-clip: text;
  background-clip: text;

  color: transparent;
}

.dbf-main-hero p {
  max-width: 480px;

  margin: 0;

  color: #52647d;

  font-size: 12px;
  line-height: 1.75;
}

.dbf-main-buttons,
.dbf-preview-cta-row {
  display: flex;

  flex-wrap: wrap;

  gap: 9px;

  margin-top: 23px;
}

.dbf-main-buttons button,
.dbf-preview-cta-row button {
  min-height: 40px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  padding: 0 15px;

  border: 0;

  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #7c3aed
    );

  color: #ffffff;

  font-size: 9px;
  font-weight: 900;

  box-shadow:
    0 10px 25px rgba(37,99,235,.22);

  cursor: pointer;
}

.dbf-main-buttons .secondary,
.dbf-preview-cta-row .secondary {
  background: #ffffff !important;

  color: #334155 !important;

  border:
    1px solid #d7e0eb !important;

  box-shadow: none;
}

/* ============================================================
   HERO OBJECT
   ============================================================ */

.dbf-hero-object {
  min-height: 270px;

  position: relative;

  display: grid;

  place-items: center;
}

.orb {
  position: absolute;

  border:
    1px solid rgba(37,99,235,.20);

  border-radius: 50%;

  box-shadow:
    inset 0 0 35px rgba(37,99,235,.05);
}

.orb-1 {
  width: 245px;
  height: 245px;
}

.orb-2 {
  width: 164px;
  height: 164px;

  border-color:
    rgba(139,92,246,.25);
}

.hero-card {
  position: relative;

  width: 180px;
  height: 192px;

  display: flex;

  flex-direction: column;

  justify-content: center;
  align-items: center;

  gap: 8px;

  border:
    1px solid #d7e1ee;

  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #eaf2ff 58%,
      #f5edff
    );

  color: var(--dbf-blue);

  box-shadow:
    0 28px 55px rgba(37,99,235,.15),
    0 5px 15px rgba(15,23,42,.05);

  transform: rotate(-3deg);
}

.hero-card::before {
  content: "";

  position: absolute;

  inset: 10px;

  border:
    1px solid rgba(37,99,235,.10);

  border-radius: 15px;
}

.hero-card strong {
  position: relative;

  color: #172033;

  font-size: 19px;
  font-weight: 950;
}

.hero-card span {
  position: relative;

  color: #64748b;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: .17em;
}

/* ============================================================
   FEATURE STRIP
   ============================================================ */

.dbf-feature-strip,
.dbf-preview-features {
  display: grid;

  grid-template-columns:
    repeat(3,1fr);

  gap: 1px;

  background: #dce5ef;

  border-top: 1px solid #dce5ef;
  border-bottom: 1px solid #dce5ef;
}

.dbf-feature-strip > div,
.dbf-preview-features > div {
  padding: 23px;

  background:
    linear-gradient(
      135deg,
      #ffffff,
      #f7faff
    );
}

.dbf-feature-strip > div:nth-child(2),
.dbf-preview-features > div:nth-child(2) {
  background:
    linear-gradient(
      135deg,
      #fbfaff,
      #f6f1ff
    );
}

.dbf-feature-strip > div:nth-child(3),
.dbf-preview-features > div:nth-child(3) {
  background:
    linear-gradient(
      135deg,
      #f7fdff,
      #f1fbff
    );
}

.dbf-feature-strip strong,
.dbf-preview-features strong {
  display: block;

  color: #172033;

  font-size: 10px;
  font-weight: 900;
}

.dbf-feature-strip span,
.dbf-preview-features span {
  display: block;

  margin-top: 5px;

  color: #64748b;

  font-size: 8px;
  line-height: 1.45;
}

/* ============================================================
   PRODUCTS
   ============================================================ */

.dbf-products,
.dbf-preview-products {
  background: #ffffff;
}

.dbf-products {
  padding: 30px;
}

.dbf-products-heading {
  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 14px;

  margin-bottom: 17px;
}

.dbf-products-heading > div {
  display: flex;

  flex-direction: column;
}

.dbf-products-heading span:first-child {
  color: #2563eb;

  font-size: 8px;
  font-weight: 950;

  letter-spacing: .15em;
}

.dbf-products-heading strong {
  margin-top: 4px;

  color: #172033;

  font-size: 18px;
  font-weight: 900;

  letter-spacing: -.02em;
}

.dbf-products-heading > span:last-child {
  color: #64748b;

  font-size: 9px;
  font-weight: 800;
}

.dbf-product-grid,
.dbf-preview-products {
  display: grid;

  grid-template-columns:
    repeat(3,1fr);

  gap: 15px;
}

.dbf-product-grid article,
.dbf-preview-products article {
  padding: 8px;

  border:
    1px solid #e0e8f1;

  border-radius: 13px;

  background: #ffffff;

  box-shadow:
    0 5px 16px rgba(15,23,42,.035);

  transition:
    transform .16s ease,
    box-shadow .16s ease,
    border-color .16s ease;
}

.dbf-product-grid article:hover,
.dbf-preview-products article:hover {
  transform: translateY(-3px);

  border-color: #a5c7f7;

  box-shadow:
    0 15px 30px rgba(15,23,42,.08);
}

.dbf-card-image,
.dbf-product-art {
  min-height: 150px;

  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      #dceaff,
      #eee3ff
    );
}

.card-2,
.art-2 {
  background:
    linear-gradient(
      135deg,
      #dff9f1,
      #dcecff
    );
}

.card-3,
.art-3 {
  background:
    linear-gradient(
      135deg,
      #fff0dd,
      #eadfff
    );
}

.dbf-product-grid span,
.dbf-preview-products article > span {
  display: block;

  margin: 9px 2px 5px;

  color: #64748b;

  font-size: 8px;
}

.dbf-product-grid strong,
.dbf-preview-products article > strong {
  color: #172033;

  font-size: 10px;
  font-weight: 900;
}

/* ============================================================
   STORY
   ============================================================ */

.dbf-story {
  padding: 55px;

  background:
    radial-gradient(
      circle at 90% 30%,
      rgba(124,58,237,.13),
      transparent 25%
    ),
    radial-gradient(
      circle at 10% 90%,
      rgba(6,182,212,.08),
      transparent 25%
    ),
    linear-gradient(
      135deg,
      #f8faff,
      #f5f0ff
    );
}

.dbf-story > span {
  color: #7c3aed;

  font-size: 8px;
  font-weight: 950;

  letter-spacing: .15em;
}

.dbf-story h2 {
  max-width: 670px;

  margin: 12px 0;

  color: #172033;

  font-size: 30px;
  line-height: 1.08;

  letter-spacing: -.035em;

  font-weight: 900;
}

.dbf-story p {
  max-width: 650px;

  color: #64748b;

  font-size: 11px;
  line-height: 1.75;
}

/* ============================================================
   STATUS
   ============================================================ */

.dbf-statusbar {
  min-height: 38px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 10px;

  padding: 0 15px;

  border-top:
    1px solid var(--dbf-border);

  background:
    #0a1728;

  color: var(--dbf-muted);

  font-size: 8px;
  font-weight: 800;
}

.dbf-statusbar > span:first-child {
  display: flex;

  align-items: center;

  gap: 7px;
}

.dbf-statusbar > span:first-child::before {
  content: "";

  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: var(--dbf-green);

  box-shadow:
    0 0 10px rgba(16,185,129,.7);
}

/* ============================================================
   RIGHT INSPECTOR
   ============================================================ */

.dbf-right {
  min-width: 0;

  padding: 17px 14px;

  overflow: auto;

  background:
    linear-gradient(
      180deg,
      #0d1a2c,
      #091424
    );

  border-left:
    1px solid var(--dbf-border);
}

.dbf-inspector-selected {
  display: flex;

  align-items: center;

  gap: 9px;

  margin-bottom: 16px;

  padding: 11px;

  border:
    1px solid var(--dbf-border-strong);

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      rgba(59,130,246,.09),
      rgba(139,92,246,.08)
    );

  box-shadow:
    0 7px 20px rgba(0,0,0,.14);
}

.dbf-inspector-selected > div {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  border-radius: 9px;

  background:
    linear-gradient(
      135deg,
      rgba(59,130,246,.22),
      rgba(139,92,246,.22)
    );

  color: #c4b5fd;

  border:
    1px solid rgba(139,92,246,.24);
}

.dbf-inspector-selected section {
  display: flex;

  flex-direction: column;
}

.dbf-inspector-selected strong {
  color: #f8fafc;

  font-size: 10px;
  font-weight: 900;
}

.dbf-inspector-selected span {
  margin-top: 3px;

  color: var(--dbf-muted);

  font-size: 8px;
}

.dbf-field {
  display: block;

  margin-bottom: 15px;
}

.dbf-field > span,
.dbf-inspector-section > span {
  display: block;

  margin-bottom: 7px;

  color: #7286a1;

  font-size: 8px;
  font-weight: 950;

  letter-spacing: .13em;
}

.dbf-field input,
.dbf-field textarea {
  width: 100%;

  border:
    1px solid var(--dbf-border-strong) !important;

  border-radius: 9px !important;

  background:
    rgba(255,255,255,.045) !important;

  color:
    #f8fafc !important;

  padding: 9px 10px;

  font: inherit;
  font-size: 9px;

  outline: none;

  box-shadow:
    inset 0 1px 1px rgba(0,0,0,.10);

  transition:
    border-color .15s ease,
    background .15s ease,
    box-shadow .15s ease;
}

.dbf-field input::placeholder,
.dbf-field textarea::placeholder {
  color: #61738d;
}

.dbf-field input:focus,
.dbf-field textarea:focus {
  border-color:
    rgba(59,130,246,.70) !important;

  background:
    rgba(59,130,246,.055) !important;

  box-shadow:
    0 0 0 3px rgba(59,130,246,.10);
}

.dbf-inspector-section {
  padding: 15px 0;

  border-top:
    1px solid var(--dbf-border);
}

.dbf-palette {
  display: flex;

  gap: 8px;
}

.dbf-palette i {
  width: 22px;
  height: 22px;

  border-radius: 7px;

  border:
    2px solid #15253a;

  box-shadow:
    0 0 0 1px rgba(148,163,184,.30),
    0 4px 10px rgba(0,0,0,.18);
}

.dbf-color-violet {
  background: #8b5cf6;
}

.dbf-color-blue {
  background: #3b82f6;
}

.dbf-color-cyan {
  background: #06b6d4;
}

.dbf-color-green {
  background: #10b981;
}

.dbf-color-pink {
  background: #ec4899;
}

.dbf-slider-label {
  display: flex;

  align-items: center;

  justify-content: space-between;

  color: #8da1bb;

  font-size: 9px;
  font-weight: 750;
}

.dbf-slider-label strong {
  color: #e5edf8;

  font-size: 9px;
}

.dbf-range {
  width: 100%;

  margin-top: 10px;

  accent-color: var(--dbf-blue);
}

/* ============================================================
   AI ACTION
   ============================================================ */

.dbf-ai {
  width: 100%;

  display: grid;

  grid-template-columns:
    30px
    minmax(0,1fr)
    14px;

  align-items: center;

  gap: 8px;

  padding: 11px;

  border:
    1px solid rgba(139,92,246,.35);

  border-radius: 12px;

  background:
    radial-gradient(
      circle at 0% 0%,
      rgba(139,92,246,.17),
      transparent 45%
    ),
    linear-gradient(
      135deg,
      rgba(59,130,246,.09),
      rgba(139,92,246,.10)
    );

  color: #c4b5fd;

  cursor: pointer;

  text-align: left;

  box-shadow:
    0 8px 22px rgba(0,0,0,.16);
}

.dbf-ai > svg:first-child {
  width: 30px;
  height: 30px;

  padding: 7px;

  border-radius: 8px;

  background:
    linear-gradient(
      135deg,
      rgba(59,130,246,.25),
      rgba(139,92,246,.25)
    );
}

.dbf-ai > div {
  min-width: 0;

  display: flex;

  flex-direction: column;
}

.dbf-ai strong {
  color: #ffffff;

  font-size: 9px;
  font-weight: 900;
}

.dbf-ai span {
  margin-top: 3px;

  color: var(--dbf-muted);

  font-size: 8px;

  line-height: 1.3;
}

/* ============================================================
   PREVIEW
   ============================================================ */

.dbf-preview-shell {
  min-height: calc(100vh - 24px);

  background:
    radial-gradient(
      circle at 8% 0%,
      rgba(59,130,246,.12),
      transparent 25%
    ),
    radial-gradient(
      circle at 96% 6%,
      rgba(139,92,246,.12),
      transparent 22%
    ),
    linear-gradient(
      180deg,
      #07111f,
      #0c1829
    ) !important;
}

.dbf-preview-header {
  min-height: 76px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  padding: 0 20px;

  background:
    rgba(10,24,41,.94);

  border-bottom:
    1px solid var(--dbf-border);

  backdrop-filter: blur(16px);
}

.dbf-preview-header > div {
  display: flex;

  flex-direction: column;
}

.dbf-preview-header h2 {
  margin: 4px 0 0;

  color: #ffffff;

  font-size: 15px;

  font-weight: 900;
}

.dbf-kicker {
  color: #60a5fa;

  font-size: 8px;

  font-weight: 950;

  letter-spacing: .16em;
}

.dbf-preview-stage {
  padding: 28px;

  display: flex;

  justify-content: center;

  background:
    radial-gradient(
      circle at top,
      rgba(59,130,246,.09),
      transparent 45%
    );
}

.dbf-store-preview {
  width: min(1160px,100%);

  overflow: hidden;

  background: #ffffff;

  border:
    1px solid rgba(148,163,184,.28);

  border-radius: 20px;

  box-shadow:
    0 35px 80px rgba(0,0,0,.38);
}

.dbf-preview-accent {
  height: 4px;

  background:
    linear-gradient(
      90deg,
      #2563eb,
      #7c3aed,
      #06b6d4,
      #10b981
    );
}

.dbf-preview-nav {
  min-height: 64px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  padding: 0 28px;

  background: #ffffff;

  border-bottom:
    1px solid #e8eef5;
}

.dbf-preview-logo {
  color: #111827;

  font-size: 11px;

  font-weight: 950;

  letter-spacing: .095em;
}

.dbf-preview-logo span {
  color: #2563eb;
}

.dbf-preview-nav nav {
  display: flex;

  align-items: center;

  gap: 20px;

  color: #64748b;

  font-size: 9px;

  font-weight: 700;
}

.dbf-preview-bag {
  width: 32px;
  height: 32px;

  display: grid;
  place-items: center;

  border:
    1px solid #dbe4ee;

  border-radius: 9px;

  background: #ffffff;

  color: #334155;
}

.dbf-preview-hero {
  padding: 82px 60px 68px;

  background:
    radial-gradient(
      circle at 81% 43%,
      rgba(37,99,235,.13),
      transparent 24%
    ),
    radial-gradient(
      circle at 91% 8%,
      rgba(124,58,237,.12),
      transparent 18%
    ),
    linear-gradient(
      135deg,
      #eef5ff 0%,
      #f7f1ff 62%,
      #effcff 100%
    );
}

.dbf-preview-hero h1 {
  margin: 18px 0 14px;

  color: #101828;

  font-size: clamp(42px, 5vw, 62px);

  line-height: .98;

  letter-spacing: -.05em;

  font-weight: 900;
}

.dbf-preview-hero h1 span {
  background:
    linear-gradient(
      90deg,
      #2563eb,
      #7c3aed,
      #0891b2
    );

  -webkit-background-clip: text;
  background-clip: text;

  color: transparent;
}

.dbf-preview-hero p {
  max-width: 560px;

  color: #5c6d84;

  font-size: 12px;

  line-height: 1.75;
}

/* ============================================================
   FOCUS
   ============================================================ */

.dbf-shell button:focus-visible,
.dbf-shell input:focus-visible,
.dbf-shell textarea:focus-visible {
  outline:
    2px solid rgba(59,130,246,.65);

  outline-offset: 2px;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1120px) {

  .dbf-topbar {
    grid-template-columns:
      minmax(200px,1fr)
      auto
      auto;
  }

  .dbf-layout {
    grid-template-columns:
      210px
      minmax(0,1fr)
      255px;
  }

  .dbf-main-hero {
    padding:
      54px 32px 46px;
  }

  .dbf-main-hero h1 {
    font-size: 40px;
  }
}

@media (max-width: 900px) {

  .dbf-topbar {
    grid-template-columns:
      1fr
      auto;

    min-height: auto;

    padding: 11px;
  }

  .dbf-device-switch {
    justify-self: end;
  }

  .dbf-actions {
    grid-column: 1 / -1;

    justify-self: stretch;

    width: 100%;
  }

  .dbf-button {
    flex: 1;
  }

  .dbf-layout {
    display: block;
  }

  .dbf-left,
  .dbf-right {
    border: 0;

    border-bottom:
      1px solid var(--dbf-border);
  }

  .dbf-left {
    padding: 12px;
  }

  .dbf-tools {
    grid-template-columns:
      repeat(2,1fr);
  }

  .dbf-right {
    border-top:
      1px solid var(--dbf-border);

    border-bottom: 0;
  }

  .dbf-main-hero {
    grid-template-columns: 1fr;
  }

  .dbf-hero-object {
    min-height: 220px;
  }
}

@media (max-width: 640px) {

  .dbf-shell,
  .dbf-preview-shell {
    border-radius: 14px !important;
  }

  .dbf-brand span,
  .dbf-live {
    display: none;
  }

  .dbf-canvas-area,
  .dbf-preview-stage {
    padding: 14px;
  }

  .dbf-main-hero {
    padding:
      42px 20px 34px;
  }

  .dbf-main-hero h1 {
    font-size: 31px;
  }

  .dbf-feature-strip,
  .dbf-product-grid,
  .dbf-preview-features,
  .dbf-preview-products {
    grid-template-columns: 1fr;
  }

  .dbf-story {
    padding:
      35px 20px;
  }

  .dbf-story h2 {
    font-size: 24px;
  }

  .dbf-preview-hero {
    padding:
      50px 22px;
  }

  .dbf-preview-hero h1 {
    font-size: 40px;
  }

  .dbf-preview-nav {
    padding: 0 18px;
  }

  .dbf-preview-nav nav {
    display: none;
  }
}
