            ["Diseño", "Temas, constructor y personalización.", Package, "themes"],
            ["Crecimiento", "Marketing, campañas y recuperación.", Megaphone, "marketing"],
            ["Finanzas", "Ventas, pagos e indicadores financieros.", CircleDollarSign, "payments"],
