    value: "184",
    change: "+12,1%",
    icon: ShoppingCart,
  },
  {
    label: "Clientes",
    value: "1.284",
    change: "+9,7%",
    icon: Users,
  },
  {
    label: "Conversión",
    value: "4,82%",
