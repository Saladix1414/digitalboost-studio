  },
  {
    title: "Crear campaña",
    description: "Lanzá una campaña para aumentar tus ventas.",
    icon: Megaphone,
    section: "campaigns",
  },
  {
    title: "Ver pedidos",
    description: "Revisá y gestioná tus pedidos recientes.",
