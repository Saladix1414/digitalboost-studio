} from "lucide-react";

const neon = "bg-gradient-to-r from-violet-600 via-fuchsia-500 to-cyan-400";

function DragonMark({ small = false }: { small?: boolean }) {
  return (
    <div className={`relative ${small ? "h-11 w-11" : "h-64 w-64 md:h-[330px] md:w-[330px]"}`}>
      <div className="absolute inset-0 rounded-full bg-cyan-500/10 blur-3xl" />
      <div className="absolute inset-[8%] rounded-full border border-cyan-400/30 shadow-[0_0_70px_rgba(0,190,255,.22),inset_0_0_50px_rgba(100,60,255,.12)]" />
      <svg viewBox="0 0 300 300" className="relative h-full w-full drop-shadow-[0_0_20px_rgba(0,190,255,.7)]">
        <defs>
          <linearGradient id="dbDragon" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stopColor="#18e8ff"/>
            <stop offset=".48" stopColor="#176dff"/>
            <stop offset="1" stopColor="#a500ff"/>
          </linearGradient>
        </defs>
        <circle cx="150" cy="150" r="120" fill="none" stroke="url(#dbDragon)" strokeWidth="2" opacity=".35"/>
        <path d="M65 188c35 27 74 39 111 17 35-20 55-57 44-92-7-24-28-41-54-46 19 13 27 30 22 47-7 23-32 32-50 22 4-16 2-29-8-39-14-14-34-15-51-3 17-2 30 7 35 19 6 14 0 28-12 37-13 10-27 13-42 8 7 13 7 22 5 30z" fill="url(#dbDragon)" opacity=".95"/>
        <path d="M139 88c-2-20 5-36 22-50l8 25 25-18-7 31 27-3-25 20 20 10-35 7z" fill="url(#dbDragon)"/>
        <path d="M101 194c-18 14-30 30-38 48 25-8 48-19 68-35M192 197c17 8 34 21 48 39-25-2-48-9-68-23" fill="none" stroke="url(#dbDragon)" strokeWidth="8" strokeLinecap="round"/>
        <circle cx="178" cy="108" r="4" fill="#fff"/>
      </svg>
    </div>
  );
}

const stats = [
  ["15K+", "Usuarios activos", Users],
  ["2.5K+", "Proyectos creados", FolderKanban],
  ["850+", "Tiendas online", ShoppingCart],
