  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "test:pulse": "node --experimental-strip-types --import ./tests/pulse/ts-resolve-register.mjs --test tests/pulse/*.test.ts",
    "test:brain-boost": "node --experimental-strip-types --test tests/brain-boost/*.test.ts",
    "test:neon-arena:browser": "node tests/brain-boost/runNeonArenaBrowserSuite.mjs",
    "test:neon-arena:browser:core": "node tests/brain-boost/runNeonArenaBrowserSuite.mjs immersive held-assist aim coop progression",
    "capture:neon-arena": "node tests/brain-boost/runNeonArenaBrowserSuite.mjs industrial",
    "typecheck:neon-arena": "tsc -p tsconfig.neon-arena.json",
    "test:websites-builder": "node --experimental-strip-types --test tests/websites-builder/*.test.ts",
    "infra:migrate": "node --experimental-strip-types --import ./tests/pulse/ts-resolve-register.mjs ./src/server/infrastructure/postgresql/PostgresMigrationCli.ts",
    "test:deployment": "node --test tests/deployment/*.test.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "8.23.1",
